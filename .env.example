# ─────────────────────────────────────────────────────────────
# Boi na Rede — ambiente de DESENVOLVIMENTO
# Arquivo único: lido pelo Docker Compose, pelo Laravel (via env_file) e pelo Vite.
# ─────────────────────────────────────────────────────────────

# Aplicação
APP_NAME="Boi na Rede"
APP_ENV=development
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080
APP_PORT=8080
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt-BR
APP_CURRENCY=BRL
MAINTENANCE_SECRET=COLE_AQUI_UM_SEGREDO

# Sessão e autenticação (Laravel Sanctum — tokens pessoais)
SESSION_LIFETIME_MINUTES=120
REMEMBER_ME_DAYS=30

# Login de demonstração (card de acesso rápido)
DEMO_LOGIN_ENABLED=true
DEMO_PASSWORD=123456
DEMO_ADMIN_EMAIL=admin@admin.com
DEMO_SELLER_EMAIL=vendedor@boinarede.com.br
DEMO_BUYER_EMAIL=comprador@boinarede.com.br

# Banco de dados (MySQL via Docker)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_EXTERNAL_PORT=3307
DB_DATABASE=boinarede
DB_USERNAME=boinarede
DB_PASSWORD=troque_esta_senha
DB_ROOT_PASSWORD=troque_esta_senha_root

# Cache / fila / sessão
CACHE_STORE=database
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
REDIS_HOST=redis
REDIS_PORT=6379
LOG_CHANNEL=stack
LOG_STACK=daily

# Armazenamento de arquivos (disco local)
STORAGE_DRIVER=local
STORAGE_PATH=./storage/uploads
STORAGE_PUBLIC_URL=http://localhost:8080/uploads
UPLOAD_MAX_SIZE_MB=20
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,webp,mp4,pdf

# Gateway de pagamento (Asaas - sandbox)
ASAAS_ENV=sandbox
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=COLE_AQUI_A_CHAVE_SANDBOX_DO_ASAAS
ASAAS_WEBHOOK_TOKEN=COLE_AQUI_UM_TOKEN_DO_WEBHOOK
ASAAS_WEBHOOK_URL=http://localhost:8080/api/webhooks/asaas
PLATFORM_COMMISSION_PERCENT=5

# Login com Google
GOOGLE_CLIENT_ID=COLE_AQUI_O_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=COLE_AQUI_O_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

# Monitoramento de erros (Sentry) — backend e frontend
SENTRY_DSN=COLE_AQUI_O_DSN_DO_SENTRY
SENTRY_LARAVEL_DSN=${SENTRY_DSN}
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# E-mail e push (desativados — RN09)
MAIL_ENABLED=false
MAIL_MAILER=log
PUSH_NOTIFICATIONS_ENABLED=false

# Docker (UID/GID do host para arquivos com o dono correto)
UID=501
GID=20
