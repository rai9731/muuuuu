# ─────────────────────────────────────────────────────────────
# Boi na Rede — ambiente de PRODUÇÃO
# No servidor, copie este arquivo para `.env` (o Compose e o Laravel leem `.env`).
# ─────────────────────────────────────────────────────────────

# Aplicação
APP_NAME="Boi na Rede"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://www.boinarede.com.br
FRONTEND_URL=https://www.boinarede.com.br
APP_DOMAIN=www.boinarede.com.br
APP_PORT=8080
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt-BR
APP_CURRENCY=BRL
MAINTENANCE_SECRET=COLE_AQUI_UM_SEGREDO_PARA_PREVIEW_EM_MANUTENCAO
CERTBOT_EMAIL=COLE_AQUI_O_EMAIL_PARA_O_LETS_ENCRYPT

# Sessão e autenticação (Laravel Sanctum — tokens pessoais)
SESSION_LIFETIME_MINUTES=120
REMEMBER_ME_DAYS=30

# Login de demonstração (troque para false quando houver usuários reais)
DEMO_LOGIN_ENABLED=true
DEMO_PASSWORD=123456
DEMO_ADMIN_EMAIL=admin@admin.com
DEMO_SELLER_EMAIL=vendedor@boinarede.com.br
DEMO_BUYER_EMAIL=comprador@boinarede.com.br

# Banco de dados (MySQL via Docker) — aspas simples: valores literais ($ e # não são interpretados)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=boinarede
DB_USERNAME=boinarede
DB_PASSWORD=COLE_AQUI_A_SENHA_DO_BANCO
DB_ROOT_PASSWORD=COLE_AQUI_A_SENHA_ROOT

# Cache / fila / sessão
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=array
REDIS_HOST=redis
REDIS_PORT=6379
LOG_CHANNEL=stack
LOG_STACK=daily

# Armazenamento de arquivos (disco local)
STORAGE_DRIVER=local
STORAGE_PATH=/var/app/storage/uploads
STORAGE_PUBLIC_URL=https://www.boinarede.com.br/uploads
UPLOAD_MAX_SIZE_MB=20
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,webp,mp4,pdf

# Gateway de pagamento (Asaas - produção)
ASAAS_ENV=production
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_API_KEY=COLE_AQUI_A_CHAVE_DE_PRODUCAO_DO_ASAAS
ASAAS_WEBHOOK_TOKEN=COLE_AQUI_UM_TOKEN_DO_WEBHOOK
ASAAS_WEBHOOK_URL=https://www.boinarede.com.br/api/webhooks/asaas
PLATFORM_COMMISSION_PERCENT=5

# Login com Google
GOOGLE_CLIENT_ID=COLE_AQUI_O_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=COLE_AQUI_O_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://www.boinarede.com.br/auth/google/callback

# Monitoramento de erros (Sentry)
SENTRY_DSN=COLE_AQUI_O_DSN_DO_SENTRY
SENTRY_LARAVEL_DSN=${SENTRY_DSN}
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2

# E-mail e push (desativados — RN09)
MAIL_ENABLED=false
MAIL_MAILER=log
PUSH_NOTIFICATIONS_ENABLED=false

# Docker
UID=1000
GID=1000
